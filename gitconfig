[user]
    name = Sam Tanaka
    email = sam@example.com

[alias]
    co = checkout
    br = branch
    st = status
    lg = log --oneline --graph --all --decorate
    unstage = reset HEAD --
    last = log -1 HEAD

[core]
    editor = vim
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main
